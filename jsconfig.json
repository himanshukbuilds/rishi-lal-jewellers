{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "jsx": "preserve",
    "checkJs": false,
    "paths": {
      "@/*": ["./frontend/src/*"]
    }
  },
  "include": [
    "frontend/src/**/*",
    "frontend/**/*.js",
    "frontend/**/*.jsx",
    "backend/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "frontend/.next"
  ]
}

# ==============================================================================
# RISHI LAL JEWELLERS - FRONTEND ENVIRONMENT CONFIGURATION (VERCEL / NEXT.JS)
# ==============================================================================
# In local development: copy to .env.local
# In production on Vercel: configure in Project Settings -> Environment Variables

# Backend API Base URL
# Local development default:
# NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Production Render Web Service URL:
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com/api

# Public Canonical Site URL (Optional, for SEO/metadata)
NEXT_PUBLIC_SITE_URL=https://your-frontend-app.vercel.app

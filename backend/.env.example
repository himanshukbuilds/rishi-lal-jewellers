# ==============================================================================
# RISHI LAL JEWELLERS - PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and replace placeholders with actual credentials.
# NEVER commit .env to GitHub or version control.

# Server Configuration
PORT=5001
NODE_ENV=production

# Database Connection (MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rishi_lal_jewellers?retryWrites=true&w=majority

# Local Development Fallback (Optional)
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/rishi_lal_jewellers

# Authentication & Security
# Generate a cryptographically random 256-bit secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_production_64_character_hex_secret_here
JWT_EXPIRES_IN=7d

# CORS & Frontend Origins
# In production, set to your Vercel deployment URL (e.g. https://rishi-lal-jewellers.vercel.app)
CLIENT_URL=https://your-frontend-app.vercel.app
APP_BASE_URL=https://your-frontend-app.vercel.app
# Comma-separated list of additional allowed origins (e.g. custom domain, preview domains)
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,https://www.rishilaljewellers.com

# Razorpay Payment Gateway (https://dashboard.razorpay.com)
# For test mode: rzp_test_... | For production mode: rzp_live_...
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Transactional Email Provider (Resend - https://resend.com)
# 1. Sign up at https://resend.com and create an API key
# 2. For dev testing: EMAIL_FROM='Rishi Lal Jewellers <onboarding@resend.dev>'
# 3. For custom domain: Verify DNS in Resend and use your verified sender
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Rishi Lal Jewellers <concierge@rishilaljewellers.com>

# Google Gemini AI Luxury Concierge (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Precious Metal Market Price Providers (Optional)
# IBJA (India Bullion and Jewellers Association)
IBJA_ACCESS_TOKEN=your_ibja_access_token_here
IBJA_ENV=production

# GoldAPI.io (Live Spot Bullion XAU/INR & XAG/INR)
GOLDAPI_KEY=your_goldapi_key_here

# RapNet / Rapaport Diamond Valuation API
RAPAPORT_CLIENT_ID=your_rapaport_client_id_here
RAPAPORT_CLIENT_SECRET=your_rapaport_client_secret_here

PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/rishilal_jewellers
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:5001
NODE_ENV=development

# Transactional Email Provider (Resend - https://resend.com)
# 1. Sign up at https://resend.com and generate an API key (re_...)
# 2. For testing/prototyping, use: EMAIL_FROM='Rishi Lal Jewellers <onboarding@resend.dev>'
# 3. For custom production domains, verify your domain in Resend DNS (e.g. mail.rishilaljewellers.com)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Rishi Lal Jewellers <onboarding@resend.dev>

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Precious Metal Market Price Providers
# Option 1: Official IBJA Rates API (India Bullion and Jewellers Association)
# Documentation: https://indiagoldratesapi.com/Documentation.aspx
IBJA_ACCESS_TOKEN=your_ibja_access_token_here
IBJA_ENV=production

# Option 2: GoldAPI.io (Live Spot Bullion XAU/INR & XAG/INR)
# Documentation: https://www.goldapi.io/
GOLDAPI_KEY=your_goldapi_key_here

# Diamond Valuation: Rapaport Diamond Price Index (RapNet B2B)
# Documentation: https://rapaport.com/diamond-price-index/
RAPAPORT_CLIENT_ID=your_rapaport_client_id_here
RAPAPORT_CLIENT_SECRET=your_rapaport_client_secret_here
